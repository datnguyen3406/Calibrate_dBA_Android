<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121824"
    android:padding="20dp">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calibrate dBA"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Hiển thị số dBA chính -->
    <TextView
        android:id="@+id/tvDbaValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0.0 dBA"
        android:textColor="#00E676"
        android:textSize="52sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Thông số Min / Max & Trạng thái -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvMinMax"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Min: 0.0 dBA   |   Max: 0.0 dBA"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="370dp"
        android:layout_height="17dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Trạng thái: Đã dừng"
        android:textColor="#FFD740"
        android:textSize="14sp" />

    <!-- Khung biểu đồ phổ tần số -->
    <TextView
        android:gravity="center"
        android:textStyle="bold"
        android:layout_width="214dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:layout_marginBottom="6dp"
        android:text="Phổ tần số (20 Hz - 20 kHz)"
        android:textColor="#90A4AE"
        android:textSize="15sp" />

    <com.example.calibratedba.SpectrumView
        android:id="@+id/spectrumView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E2638" />

    <!-- Cụm tinh chỉnh Calibration Offset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E2638"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnMinusOffset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textAlignment="center"
            android:textSize="30sp"
            android:padding="0dp"/>

        <TextView
            android:layout_gravity="center"
            android:gravity="center"
            android:textStyle="bold"
            android:id="@+id/tvOffset"
            android:layout_width="192dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Hiệu chuẩn (Offset): 0.0 dB"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="0dp"
            android:id="@+id/btnPlusOffset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="+"
            android:textSize="30sp"
            />
    </LinearLayout>

    <!-- Cụm nút điều khiển Bắt đầu / Dừng (Chỉ 1 nút duy nhất) -->
    <Button
        android:id="@+id/btnStartStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#00C853"
        android:text="BẮT ĐẦU"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>